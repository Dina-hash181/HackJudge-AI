{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/fixtures.json",
      "destination": "/public/fixtures.json"
    },
    {
      "source": "/static/(.*)",
      "destination": "/public/static/$1"
    },
    {
      "source": "/projects",
      "destination": "/public/index.html"
    },
    {
      "source": "/((?!api|static|fixtures).*)",
      "destination": "/public/index.html"
    }
  ]
}
